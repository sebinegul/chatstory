generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["chatstory"]
}

model Session {
  id                 String      @id @default(cuid())
  createdAt          DateTime    @default(now())
  expiresAt          DateTime
  status             String      @default("uploaded")
  privacyAcceptedAt  DateTime?
  clientIpHash       String?
  upload             ChatUpload?
  config             BookConfig?
  book               Book?
  order              Order?
  previewCount       Int         @default(0)

  @@schema("chatstory")
}

model ChatUpload {
  id         String  @id @default(cuid())
  sessionId  String  @unique
  session    Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filename   String
  byteSize   Int
  parsedJson String

  @@schema("chatstory")
}

model BookConfig {
  id               String  @id @default(cuid())
  sessionId        String  @unique
  session          Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personA          String
  personB          String
  relationship     String  @default("couple")
  specialDatesJson String
  chaptersJson     String
  templateId       String
  keyword          String  @default("")
  coverImage       String  @default("")
  mediaJson        String  @default("[]")

  @@schema("chatstory")
}

model Book {
  id               String  @id @default(cuid())
  sessionId        String  @unique
  session          Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  title            String
  titleOptionsJson String
  dedication       String
  pagesJson        String
  isWatermarked    Boolean @default(true)

  @@schema("chatstory")
}

model Order {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  session     Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  amountPaise Int       @default(4900)
  status      String    @default("mock_pending")
  unlockedAt  DateTime?

  @@map("orders")
  @@schema("chatstory")
}

model RateLimit {
  id       String @id @default(cuid())
  ipHash   String
  dayKey   String
  previews Int    @default(0)

  @@unique([ipHash, dayKey])
  @@schema("chatstory")
}
